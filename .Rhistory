library("ggplot2")
setwd("~/RepData_PeerAssessment1")
data <- read.csv("data/activity.csv")
daily_counts <- aggregate(steps ~ date, data = data, FUN = sum, na.action = na.omit)
ggplot(daily_counts, aes(x = steps)) +
geom_histogram(bins = 30, fill = "steelblue", colour = "white", alpha = 0.75) +
theme_minimal() +
labs(title = "Daily Steps (imputed)", x = "Steps", y = "Frequency")
mean_steps <- mean(daily_counts$steps)
median_steps <- median(daily_counts$steps)
interval_avg <- aggregate(steps ~ interval, data = data, FUN = sum, na.action = na.omit)
ggplot(interval_avg, aes(x = interval, y = steps)) +
geom_line(color = "steelblue", alpha = 0.75, linewidth = 0.75) +
theme_minimal() +
labs(title = "5-minute Interval Steps", subtitle = "Average number of steps taken by 5-min interval, across days",
x = "Interval", y = "Number of Steps")
max_nr_steps <- interval_avg[which.max(interval_avg$steps), ]
na_idx <- is.na(data$steps)
nr_of_NAs <- sum(na_idx)
data_imp <- data
data_imp$steps[na_idx] <- interval_avg$steps[match(data_imp$interval[na_idx], interval_avg$interval)]
daily_counts_imp <- aggregate(steps ~ date, data = data_imp, FUN = sum)
ggplot(daily_counts_imp, aes(x = steps)) +
geom_histogram(bins = 30, fill = "steelblue", colour = "white", alpha = 0.75) +
theme_minimal() +
labs(title = "Daily Steps (imputed)", x = "Steps", y = "Frequency")
mean_steps <- mean(daily_counts_imp$steps)
median_steps <- median(daily_counts_imp$steps)
